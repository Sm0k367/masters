{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "masters",
  "account_id": "524a87e324a5a3515fb6746e9567aff0",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "masters",
    },
  ],
  "images": {
    "binding": "IMAGES",
  },
  "routes": [
    {
      "pattern": "masters.epictechai.app",
      "custom_domain": true,
    },
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "kv_namespaces": [
    {
      "binding": "LIVE",
      "id": "c3dec5eabc0f4cd49e912f99451d635a",
    },
  ],
}
